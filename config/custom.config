# Copy this to config/custom.config (gitignored — never commit it) to point
# the standalone `python src/main.py` at a real deployment's broker instead of
# the in-process default, as one tenant of it. Written against a cltl-apps
# checkout's root servers/+clients/ stacks (see ../../doc/DEPLOYMENT.md); the
# ports below are servers/eliza's (storage on 8001) and clients/chat-ui's
# tenant port, reached from OUTSIDE the `cltl-platform` Docker network.
#
#   docker compose -f ../../servers/broker/docker-compose.yml \
#                   -f ../../servers/eliza/docker-compose.yml up -d --wait
#   cp config/custom.config.example config/custom.config
#   CLTL_AMQP_URL=amqp://eliza:eliza123@127.0.0.1:5672/ CLTL_TENANT=tenant-a \
#       CLTL_STORAGE_URL=http://127.0.0.1:8001/storage/ \
#       venv/bin/python src/main.py
#
# CLTL_STORAGE_URL is where `cltl-storage:image/<id>` resolves — the address of
# the deployment's storage service, from OUTSIDE its compose network, with the
# trailing slash. [myorg.example] image_storage_url reads it, and the module
# refuses to start on an empty or unexpanded value while topic_image is set.
# Empty [myorg.example] topic_image in this file instead to run text-only.
#
# CLTL_TENANT is what this section demonstrates: tenant id handling. Left
# empty, this module binds `<topic>.#` and answers every tenant on the
# exchange — correct only for a single-tenant deployment. Scenario creation is
# NOT this module's job against this platform: a real `cltl-context` (e.g.
# clients/context, one per tenant) opens it.
#
# $VAR interpolation happens at READ time (EnvInterpolation, in
# cltl.combot.infra.config.local), not when this file is parsed. An *unset*
# variable is passed through as the literal string "$CLTL_TENANT" with only a
# logger.warning, and KombuEventBus then treats that literal as a real tenant
# name and binds a real, valid, permanently empty queue.

[cltl.event]
implementation: kombu

[cltl.event.kombu]
server: $CLTL_AMQP_URL
exchange: cltl.combot
compression: bzip2
tenant: $CLTL_TENANT

# Read by cltl.backend's ClientImageSource, which the object recognition
# service uses to fetch images. storage_url is where `cltl-storage:image/<id>`
# resolves (keep the trailing slash); server_image_url is only used when an
# image event carries no location.
[cltl.backend]
storage_url: $CLTL_STORAGE_URL
server_image_url: http://127.0.0.1:8000/host

[cltl.object_recognition]
#implementation: proxy
#implementation: ollama
implementation: llama_cpp

[cltl.object_recognition.proxy]
start_infra: True

[cltl.object_recognition.ollama]
model: qwen2.5vl

[cltl.object_recognition.llama_cpp]
model: Qwen3VL-8B-Instruct
host: http://localhost:9009
frequency_penalty: 0.3

[cltl.object_recognition.proxy]
start_infra: True

[cltl.object_recognition.events]
image_topic: cltl.topic.image
object_topic: cltl.topic.object_recognition

[cltl.situation-awareness]
object_input : cltl.topic.object_recognition
# Differences in the count of an object label up to this value are ignored when comparing images
count_threshold : 1
# Number of images that reflect a change kept per scenario to compare new images with
history_size : 10
# Knowledge graph (GraphDB repository) to push the scenes seen during an interaction to, as capsules
# with the objects in each scene. Scenes are not pushed if empty or unset.
#kg_address : http://localhost:7200/repositories/scene_capsule_test
kg_address : http://localhost:7200/repositories/event_sandbox
kg_log_dir : kg_logs
# Regulates how many changes of a scene are pushed to the knowledge graph, between 0 and 1. A scene type
# is always pushed the first time it is seen in an interaction. After that it is pushed again only if the
# similarity of its objects to the objects last pushed for that scene is below this value. The similarity is
# the sum of the minimum count per object category divided by the sum of the maximum count, e.g. 0.75 for
# {chair: 1, person: 3} and {chair: 1, person: 4}, and 0.2 for {chair: 1, desk: 1, person: 1} and
# {chair: 1, cup: 1, laptop: 1}.
#   0.0  only push each scene type once per interaction (fewest pushes)
#   0.6  push when the objects changed substantially (default)
#   1.0  push every change in the objects of a scene (most pushes)
similarity_threshold : 0.6
# Sensor recorded as the source of the scenes
source : front-camera
# The context (place) of each interaction is pushed once if place is set
# place : Piek's office
# country : NL
# region : North Holland
# city : Amsterdam

[cltl.visual-responder]
text_input : cltl.topic.text_in
topic_output : cltl.topic.text_out
#topic_output : cltl.topic.vision_out
# Comma separated cues, the visual responder only responds to statements that contain one of
# them as whole words. see_cues report what is seen, change_cues report what changed.
see_cues : look, what do you see, what can you see, what did you see, what have you seen
change_cues : what changed, what has changed, what's changed, what is different, what's different,
    what is new, what's new, anything new, anything changed, any change, any changes, difference, differences
