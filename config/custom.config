# Copy this to config/custom.config (gitignored — never commit it) to point
# the standalone `python src/main.py` at a real deployment's broker instead of
# the in-process default, as one tenant of it. Written against a cltl-apps
# checkout's root servers/+clients/ stacks (see ../../doc/DEPLOYMENT.md); the
# ports below are servers/eliza's (storage on 8001) and clients/chat-ui's
# tenant port, reached from OUTSIDE the `cltl-platform` Docker network.
#
#   docker compose -f ../../servers/broker/docker-compose.yml \
#                   -f ../../servers/eliza/docker-compose.yml up -d --wait
#   cp config/custom.config.example config/custom.config
#   CLTL_AMQP_URL=amqp://eliza:eliza123@127.0.0.1:5672/ CLTL_TENANT=tenant-a \
#       CLTL_STORAGE_URL=http://127.0.0.1:8001/storage/ \
#       venv/bin/python src/main.py
#
# CLTL_STORAGE_URL is where `cltl-storage:image/<id>` resolves — the address of
# the deployment's storage service, from OUTSIDE its compose network, with the
# trailing slash. [myorg.example] image_storage_url reads it, and the module
# refuses to start on an empty or unexpanded value while topic_image is set.
# Empty [myorg.example] topic_image in this file instead to run text-only.
#
# CLTL_TENANT is what this section demonstrates: tenant id handling. Left
# empty, this module binds `<topic>.#` and answers every tenant on the
# exchange — correct only for a single-tenant deployment. Scenario creation is
# NOT this module's job against this platform: a real `cltl-context` (e.g.
# clients/context, one per tenant) opens it.
#
# $VAR interpolation happens at READ time (EnvInterpolation, in
# cltl.combot.infra.config.local), not when this file is parsed. An *unset*
# variable is passed through as the literal string "$CLTL_TENANT" with only a
# logger.warning, and KombuEventBus then treats that literal as a real tenant
# name and binds a real, valid, permanently empty queue.

[cltl.event]
implementation: kombu

[cltl.event.kombu]
server: $CLTL_AMQP_URL
exchange: cltl.combot
compression: bzip2
tenant: $CLTL_TENANT

# Read by cltl.backend's ClientImageSource, which the object recognition
# service uses to fetch images. storage_url is where `cltl-storage:image/<id>`
# resolves (keep the trailing slash); server_image_url is only used when an
# image event carries no location.
[cltl.backend]
storage_url: $CLTL_STORAGE_URL
server_image_url: http://127.0.0.1:8000/host

[cltl.object_recognition]
#implementation: proxy
implementation: vlm

[cltl.object_recognition.proxy]
start_infra: True

[cltl.object_recognition.vlm]
model: qwen2.5vl

[cltl.face_recognition.events]
image_topic: cltl.topic.image
face_topic: cltl.topic.face_recognition

[cltl.object_recognition.proxy]
start_infra: True

[cltl.object_recognition.events]
image_topic: cltl.topic.image
object_topic: cltl.topic.object_recognition

[cltl.vector_id.agg]
distance_threshold: 0.66
storage_path: ./storage/vector_id

[cltl.vector_id.events]
face_topic: cltl.topic.face_recognition
id_topic: cltl.topic.face_id

